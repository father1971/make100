rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - solvedCount: number
    //   - unsolvedCount: number
    //   - totalSolveTime: number
    //   - totalOperatorsUsed: number
    //   - theme: string
    //   - language: string
    //   - gameMode: string
    //   - soundEnabled: boolean
    //   - vibrationEnabled: boolean
    //
    // Collection: public_stats
    // Document ID: {userId}
    // Fields:
    //   - solvedCount: number
    //   - unsolvedCount: number
    //   - totalSolveTime: number
    //   - totalOperatorsUsed: number
    //   - displayName: string
    //   - photoURL: string
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserStats() {
      let data = request.resource.data;
      return (
        (!('solvedCount' in data) || data.solvedCount is number) &&
        (!('unsolvedCount' in data) || data.unsolvedCount is number) &&
        (!('totalSolveTime' in data) || data.totalSolveTime is number) &&
        (!('totalOperatorsUsed' in data) || data.totalOperatorsUsed is number) &&
        (!('theme' in data) || data.theme is string) &&
        (!('language' in data) || data.language is string) &&
        (!('gameMode' in data) || data.gameMode is string) &&
        (!('soundEnabled' in data) || data.soundEnabled is bool) &&
        (!('vibrationEnabled' in data) || data.vibrationEnabled is bool)
      );
    }

    function isValidPublicStats() {
      let data = request.resource.data;
      return (
        (!('solvedCount' in data) || data.solvedCount is number) &&
        (!('unsolvedCount' in data) || data.unsolvedCount is number) &&
        (!('totalSolveTime' in data) || data.totalSolveTime is number) &&
        (!('totalOperatorsUsed' in data) || data.totalOperatorsUsed is number) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('tgUserId' in data) || data.tgUserId == null || data.tgUserId is number)
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserStats();
      allow update: if isOwner(userId) && isValidUserStats();
      allow delete: if false; // Users cannot delete their stats document
    }

    match /public_stats/{userId} {
      allow read: if true; // Public leaderboard
      allow create: if isOwner(userId) && isValidPublicStats();
      allow update: if isOwner(userId) && isValidPublicStats();
      allow delete: if false;
    }
  }
}
