rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: playerStats
    // Document ID: {telegramId}
    // Fields:
    //   - telegramId: string (required) - The Telegram user ID
    //   - firstName: string (required) - The first name of the player
    //   - lastName: string (optional) - The last name of the player
    //   - username: string (optional) - The Telegram username
    //   - solvedCount: number (required) - Total solved tickets
    //   - unsolvedCount: number (required) - Total skipped tickets
    //   - totalSolveTime: number (required) - Total time spent solving
    //   - totalOperatorsUsed: number (required) - Total operators used
    //   - lastUpdated: timestamp (required) - When the stats were last updated
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }
    
    function isValidPlayerStats() {
      let data = request.resource.data;
      return hasRequiredFields(['telegramId', 'firstName', 'solvedCount', 'unsolvedCount', 'totalSolveTime', 'totalOperatorsUsed', 'lastUpdated']) &&
             data.telegramId is string && data.telegramId.size() > 0 && data.telegramId.size() < 100 &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 100 &&
             isValidOptionalString('lastName', 0, 100) &&
             isValidOptionalString('username', 0, 100) &&
             data.solvedCount is number && data.solvedCount >= 0 &&
             data.unsolvedCount is number && data.unsolvedCount >= 0 &&
             data.totalSolveTime is number && data.totalSolveTime >= 0 &&
             data.totalOperatorsUsed is number && data.totalOperatorsUsed >= 0 &&
             data.lastUpdated is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /playerStats/{telegramId} {
      // Allow read/write if the user is authenticated anonymously.
      // We use the telegramId as the document ID.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPlayerStats() && request.resource.data.telegramId == telegramId;
      allow update: if isAuthenticated() && isValidPlayerStats() && request.resource.data.telegramId == telegramId;
    }
  }
}
